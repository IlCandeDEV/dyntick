{
  "nodeModulesDir": "auto",
  "lock": "deno.lock",
  "tasks": {
    "check": "deno check src/main.tsx vite.config.ts tests/timer_test.ts tests/cycle_test.ts tests/storage_test.ts tests/activity_test.ts scripts/browser-check.ts",
    "test": "deno test tests/",
    "build": "deno run -A npm:vite@7 build",
    "test:browser": "deno run -A scripts/browser-check.ts"
  },
  "imports": {
    "react": "npm:react@19",
    "react/jsx-runtime": "npm:react@19/jsx-runtime",
    "react/jsx-dev-runtime": "npm:react@19/jsx-dev-runtime",
    "react-dom": "npm:react-dom@19",
    "react-dom/client": "npm:react-dom@19/client",
    "@types/react": "npm:@types/react@19",
    "@types/react/jsx-runtime": "npm:@types/react@19/jsx-runtime",
    "@types/react/jsx-dev-runtime": "npm:@types/react@19/jsx-dev-runtime",
    "@types/react-dom": "npm:@types/react-dom@19",
    "@astryxdesign/core": "npm:@astryxdesign/core@0.7.13",
    "@astryxdesign/core/Button": "npm:@astryxdesign/core@0.7.13/Button",
    "@astryxdesign/core/Switch": "npm:@astryxdesign/core@0.7.13/Switch",
    "@astryxdesign/core/theme": "npm:@astryxdesign/core@0.7.13/theme",
    "@astryxdesign/theme-neutral": "npm:@astryxdesign/theme-neutral@0.7.13",
    "@astryxdesign/theme-neutral/built": "npm:@astryxdesign/theme-neutral@0.7.13/built",
    "@stylexjs/stylex": "npm:@stylexjs/stylex@0.19",
    "@fontsource-variable/ibm-plex-sans": "npm:@fontsource-variable/ibm-plex-sans@5",
    "vite": "npm:vite@7",
    "vite/client": "npm:vite@7/client",
    "playwright": "npm:playwright@1",
    "@astryxdesign/core/Selector": "npm:@astryxdesign/core@0.7.13/Selector"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "types": [
      "@types/react",
      "@types/react-dom",
      "vite/client"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  }
}
